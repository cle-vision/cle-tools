rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 채용공고 편집기: 관리자 계정으로 로그인한 사람만 읽고 쓸 수 있어요.
    // 아래 이메일은 firebase-config.js 의 adminEmail 과 똑같아야 해요.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "jobpost@clerobotics.com";
    }
  }
}
