rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(e) { return request.auth != null && request.auth.token.email == e; }
    // 관리자 계정 하나로 채용공고 편집기 + 임직원 정보 관리자를 함께 써요 (같은 비밀번호)
    function jobAdmin()    { return signedInAs("jobpost@clerobotics.com"); }
    function peopleAdmin() { return signedInAs("jobpost@clerobotics.com"); }

    // ── 채용공고 편집기 ──
    match /postings/{id} { allow read, write: if jobAdmin(); }
    match /history/{id}  { allow read, write: if jobAdmin(); }
    match /meta/{id}     { allow read, write: if jobAdmin(); }

    // ── 임직원 명단 (전체 목록은 관리자만) ──
    match /employees/{id}  { allow read, write: if peopleAdmin(); }
    match /peopleMeta/{id} { allow read, write: if peopleAdmin(); }

    // ── 명함·서명 생성기 본인 확인용 ──
    // 문서 이름이 "성명|생일"의 해시라서, 두 값을 정확히 아는 사람만 그 1명 문서를 가져올 수 있어요.
    // 목록 조회(list)는 막혀 있어서 전체 명단을 한 번에 볼 수 없어요.
    match /employeeLookup/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if peopleAdmin();
    }
  }
}
